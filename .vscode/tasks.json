{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/video-check.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "pack",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "pack",
                "${workspaceFolder}/video-check.csproj"
            ],
            "problemMatcher": "$msCompile",
            "dependsOrder": "sequence",
            "dependsOn": [
                "build"
            ]
        },
        {
            "label": "install",
            "command": "dotnet tool install -g --add-source ./dist video-check",
            "type": "shell",
            "problemMatcher": "$msCompile",
            "dependsOrder": "sequence",
            "dependsOn": [
                "pack"
            ]
        },
        {
            "label": "uninstall",
            "command": "dotnet tool uninstall -g video-check",
            "type": "shell",
            "problemMatcher": "$msCompile"
        }
    ]
}